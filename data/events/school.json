 {
  "id": "school.cheat_offer",
  "icon": "📝",
  "title": "Answer key",
  "text": "{classmate.first} has the answers to tomorrow's test and offers you a copy.",
  "conditions": {
   "age": [
    11,
    17
   ],
   "in_school": true
  },
  "choices": [
   {
    "label": "Take the answers",
    "outcomes": [
     {
      "text": "I aced the test. Nobody knows. For now.",
