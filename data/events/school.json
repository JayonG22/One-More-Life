[
 {
  "id": "school.lunch_money_thief",
  "icon": "💰",
  "title": "Lunch money",
  "text": "{rival.first} {rival.last} has taken your lunch money all week. Today {rival.he} holds out {rival.his} hand again.",
  "conditions": {
   "age": [
    7,
    11
   ],
   "in_school": true
  },
  "choices": [
   {
    "label": "Hand it over",
    "outcomes": [
     {
      "text": "I went hungry again. {rival.first} smirked.",
      "weight": 1,
      "effects": {
       "happiness": -6
      },
      "flags": [
       "lunch_thief_paid"
      ],
      "schedule": {
       "event": "work.rival_is_boss",
       "years": [
        15,
        24
       ]
      }
     },
     {
      "text": "A teacher noticed me eating a stolen apple from the cafeteria. She slipped me a lunch voucher without a word.",
      "weight": 1,
      "effects": {
       "happiness": 2,
       "karma": 1
      }
     },
     {
      "text": "It went on until the end of term. I learned to bring lunch from home.",
      "weight": 1,
      "effects": {
       "happiness": -4,
       "stress": 4,
       "smarts": 1
      }
     }
    ]
   },
   {
    "label": "Punch them",
    "outcomes": [
     {
      "text": "{rival.first} went down. The whole playground saw it.",
      "weight": 3,
      "effects": {
       "happiness": 8
      },
      "relationship": {
       "rival": -30
      },
      "trait_bonus": {
       "Hothead": 1.5,
       "Athletic": 1.5
      },
      "flags": [
       "punched_bully"
      ],
      "schedule": {
       "event": "work.rival_is_boss",
       "years": [
        15,
        24
       ]
      },
      "fight_win": true
     },
     {
      "text": "I missed. Detention for me, a story for everyone else.",
      "weight": 2,
      "effects": {
       "happiness": -4,
       "school": -4
      },
      "flags": [
       "detention_record"
      ],
      "schedule": {
       "event": "work.rival_is_boss",
       "years": [
        15,
        24
       ]
      }
     }
    ]
   },
   {
    "label": "Tell a teacher",
    "outcomes": [
     {
      "text": "The teacher handled it quietly. {rival.first} left me alone after that.",
      "weight": 1,
      "effects": {
       "karma": 2,
       "happiness": 2
      },
      "schedule": {
       "event": "work.rival_is_boss",
       "years": [
        15,
        24
       ]
      }
     },
     {
      "text": "The teacher did nothing, and {rival.first} found out I'd told. The next week was worse.",
      "weight": 1,
      "effects": {
       "happiness": -8,
       "stress": 8,
       "karma": 1
      }
     },
     {
      "text": "{rival.first}'s parents were called. {rival.first} apologised with a stiff face and never looked at me again.",
      "weight": 1,
      "effects": {
       "happiness": 4,
       "karma": 3
      }
     }
    ]
   },
   {
    "label": "Offer to split it",
    "outcomes": [
     {
      "text": "{rival.first} was so confused that {rival.he} became my friend.",
      "weight": 1,
      "effects": {
       "karma": 4,
       "happiness": 4
      },
      "relation_change": {
       "rival": "friend"
      },
      "relationship": {
       "rival": 50
      },
      "flags": [
       "rival_turned_friend"
      ]
     },
     {
      "text": "{rival.first} took all of it anyway and laughed. I didn't see the point in arguing.",
      "weight": 1,
      "effects": {
       "happiness": -4,
       "karma": 1
      }
     },
     {
      "text": "{rival.first} said nobody had ever offered before. We ended up sharing the lunch.",
      "weight": 1,
      "effects": {
       "happiness": 6,
       "karma": 5
      }
     }
    ],
    "requires": {
     "trait": "Charmer"
    }
   }
  ],
  "roles": {
   "rival": {
    "new": "rival",
    "age": "same"
   }
  },
  "once": true
 },
