 {
  "id": "school.debate_team",
  "icon": "🎙️",
  "title": "Debate team",
  "text": "Your teacher notices your effort in class and offers you a spot on the school debate team.",
  "conditions": {
   "age": [
    12,
    17
   ],
   "in_school": true
  },
  "choices": [
   {
    "label": "Join the debate team",
    "outcomes": [
     {
      "text": "We made it to the regional finals!",
      "weight": 1,
      "effects": {
       "smarts": 3,
       "happiness": 6,
       "school": 4
      },
      "stat_bonus": {
       "smarts": 1.0
      },
      "flags": [
       "debate_team"
      ]
     },
     {
      "text": "I froze during my first debate but got better every week.",
      "weight": 1,
      "effects": {
       "smarts": 2,
       "school": 2
      }
     }
    ]
   },
   {
    "label": "Ask for more details",
    "outcomes": [
     {
      "text": "It's two afternoons a week and a trip to state. I signed up.",
      "weight": 1,
      "effects": {
       "smarts": 2,
       "school": 3
      },
      "flags": [
       "debate_team"
      ]
     },
     {
      "text": "Debate turned out to be a room of people far more confident than me. I loved it.",
      "weight": 1,
      "effects": {
       "smarts": 3,
       "school": 4,
       "happiness": 4
      }
     },
     {
      "text": "I lost my first three rounds badly. By round four I'd learned how to lose well.",
      "weight": 1,
      "effects": {
       "smarts": 2,
       "school": 2,
       "stress": 4
      }
     }
    ]
   },
   {
    "label": "Decline politely",
    "outcomes": [
     {
      "text": "I told my teacher I'd think about it next year.",
      "weight": 1
     },
     {
      "text": "Next year never came. The team folded and I never knew what I'd missed.",
      "weight": 1,
      "effects": {
       "happiness": -2
      }
     },
     {
      "text": "I made a friend in the library instead, and we're still in touch.",
      "weight": 1,
      "effects": {
       "happiness": 3,
       "smarts": 1
      }
     }
    ]
   },
   {
    "label": "Ignore it",
    "outcomes": [
     {
      "text": "I pretended I didn't hear.",
      "weight": 1,
      "effects": {
       "school": -1
      }
     },
     {
      "text": "The teacher noticed and mentioned it. I felt rude and apologised.",
      "weight": 1,
      "effects": {
       "karma": 1,
       "school": -2,
       "stress": 3
      }
     },
     {
      "text": "The offer was forgotten by everyone but me. I still think about it occasionally.",
      "weight": 1,
      "effects": {
       "stress": 2
      }
     }
    ]
   }
  ],
  "once": true
