       "karma": -3
      },
      "flags": [
       "caught_cheating"
      ]
     }
    ]
   },
   {
    "label": "Refuse",
    "outcomes": [
     {
      "text": "I studied on my own and did fine.",
      "weight": 1,
      "effects": {
       "karma": 3,
