      "effects": {
       "school": 3,
       "smarts": 1,
       "stress": 3
      },
      "relationship": {
       "teacher": -4
      }
     },
     {
      "text": "Word got around. I became known as a grade-grubber for the year.",
      "weight": 1,
      "effects": {
       "school": -2,
       "popularity": -3,
       "happiness": -3
      },
      "relationship": {
       "teacher": -20
      }
     }
    ]
   }
  ],
  "roles": {
   "teacher": {
    "new": "teacher",
    "age": [
     30,
     60
    ]
   }
